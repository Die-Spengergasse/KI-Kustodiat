# LiteLLM + Whisper stack secrets template
# Copy to .env and fill in real values.

LITELLM_MASTER_KEY=sk-<replace-with-strong-random-key>
LITELLM_SALT_KEY=<replace-with-random-salt>
POSTGRES_PASSWORD=<replace-with-random-password>
DATABASE_URL=postgresql://litellm:${POSTGRES_PASSWORD}@db:5432/litellm
LITELLM_PROXY_KEY=<same-as-LITELLM_MASTER_KEY-or-a-dedicated-proxy-key>
LITELLM_PUBLIC_URL=http://10.8.0.16:11434/v1
# NOTE: 10.8.0.16 is the current VPN IP of gregor. Sync everywhere when it changes:
# opencode.json (baseURL), bash_aliases (OPENCODE_MODELS_URL), LiteLLM-DB api_base.
WHISPER_API_KEY=whisper-sk-gregor-2026

# Open WebUI LDAP bind account (Issue #22) — service account with read access to the user OU.
# At runtime the Open WebUI DB is authoritative; this only seeds a fresh deployment.
LDAP_APP_PASSWORD=<replace-with-ldap-service-account-password>
