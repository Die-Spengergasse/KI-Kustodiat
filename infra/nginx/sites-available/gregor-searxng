# gregor SearXNG — Port 80, offen im Schulnetz/VPN (Prototyp, kein TLS, keine Auth).
# Primär-Ziel für Schulklienten: Schulnetz-IP 10.50.11.10 (VPN-IP nur Admin).
# Referenzkopie — Live-File unter /etc/nginx/sites-available/ auf gregor.
server {
    listen 80 default_server;
    server_name 10.50.11.10 10.8.0.16;

    location / {
        proxy_pass http://127.0.0.1:8888;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}
