server {
    server_name openwebui.kik.spengergasse.at;

    client_max_body_size 100M;

    location / {
        proxy_pass http://10.50.11.10:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    access_log /var/log/nginx/openwebui.kik.spengergasse.at.access.log;
    error_log /var/log/nginx/openwebui.kik.spengergasse.at.error.log;

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/openwebui.kik.spengergasse.at/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/openwebui.kik.spengergasse.at/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = openwebui.kik.spengergasse.at) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name openwebui.kik.spengergasse.at;
    return 404; # managed by Certbot


}